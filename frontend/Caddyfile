{
    servers {
        trusted_proxies static private_ranges
        client_ip_headers CF-Connecting-IP
    }
}

uknowschool.ru, www.uknowschool.ru {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # SHA-256 хеши встроенных блоков из index.html.
        # pragma: allowlist nextline secret
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-j9Vi7swJyH2f2Bo2Q+idsQcbWhP/7LXrVpWg5FaC29k='; style-src 'self' 'sha256-c89WvS93uH+u1HenfJGPLlQvvXD/lz/NqyFE7OrrraQ=' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'"
        -Server
    }

    @docs path /docs /docs/* /redoc
    header @docs Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'"

    @api path /api/*
    header @api Cache-Control "no-store"

    # После обновления приложения всегда проверяем актуальность HTML.
    @html path / /index.html
    header @html Cache-Control "no-cache, must-revalidate"

    # Иконки должны отдаваться как файлы, без подмены HTML из SPA.
    @appIcons path /favicon.ico /favicon-16x16.png /favicon-32x32.png /icon-192.png /icon-512.png /icon-maskable-512.png /mstile-150x150.png /apple-touch-icon.png /manifest.webmanifest
    header @appIcons Cache-Control "public, max-age=3600"

    @chatUpload {
        method POST
        path /api/panel/conversations/*/attachments
    }
    # Учитываем заголовки при загрузке вложения до 1 ГиБ.
    request_body @chatUpload {
        max_size 1074790400
    }
    @ordinaryApi {
        path /api/*
        not path /api/admin/data/full /api/admin/data/database /api/panel/conversations/*/attachments
    }
    request_body @ordinaryApi {
        max_size 22MB
    }

    @backend path /api/* /docs /docs/* /openapi.json /redoc

    handle @backend {
        reverse_proxy backend:8000
    }

    handle @appIcons {
        root * /srv
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
