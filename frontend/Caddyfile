{
    servers {
        trusted_proxies static private_ranges
        client_ip_headers CF-Connecting-IP
    }
}

uknowschool.ru, www.uknowschool.ru {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Критический CSS и инициализация темы вынесены во внешние файлы.
        # WebKit 27.2 ошибочно считает встроенные стили системного <select> CSP-нарушением.
        # Разрешаем только атрибуты style (в том числе аудиоволны React), но не встроенные <style>.
        # pragma: allowlist nextline secret
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'"
        -Server
    }

    @docs path /docs /docs/* /redoc
    header @docs Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'"

    @api path /api/*
    header @api Cache-Control "no-store"

    # После обновления приложения всегда проверяем актуальность HTML.
    @html path / /index.html
    header @html Cache-Control "no-cache, must-revalidate"

    # Иконки должны отдаваться как файлы, без подмены HTML из SPA.
    @appIcons path /logo-main.svg /logo-touch.png /logo-192.png /logo-big.png /manifest.webmanifest
    header @appIcons Cache-Control "public, max-age=3600"

    # Обновления service worker должны быстро доходить до установленных приложений.
    @serviceWorker path /sw.js
    header @serviceWorker Cache-Control "no-cache, must-revalidate"

    @chatUpload {
        method POST
        path /api/panel/conversations/*/attachments
    }
    # Учитываем заголовки при загрузке вложения до 1 ГиБ.
    request_body @chatUpload {
        max_size 1074790400
    }
    @ordinaryApi {
        path /api/*
        not path /api/admin/data/full /api/admin/data/database /api/panel/conversations/*/attachments
    }
    request_body @ordinaryApi {
        max_size 22MB
    }

    @backend path /api/* /docs /docs/* /openapi.json /redoc

    handle @backend {
        reverse_proxy backend:8000
    }

    handle @appIcons {
        root * /srv
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
