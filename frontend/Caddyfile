{
    servers {
        trusted_proxies static private_ranges
        client_ip_headers CF-Connecting-IP
    }
}

uknowschool.ru, www.uknowschool.ru {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-j9Vi7swJyH2f2Bo2Q+idsQcbWhP/7LXrVpWg5FaC29k='; style-src 'self' 'sha256-c89WvS93uH+u1HenfJGPLlQvvXD/lz/NqyFE7OrrraQ=' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'"
        -Server
    }

    @docs path /docs /docs/* /redoc
    header @docs Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'"

    @api path /api/*
    header @api Cache-Control "no-store"

    # Always revalidate the app shell so every role receives the latest
    # hashed Vite bundle after a frontend deployment.
    @html path / /index.html
    header @html Cache-Control "no-cache, must-revalidate"

    @fullRestore {
        method POST
        path /api/admin/data/full
    }
    @databaseRestore {
        method POST
        path /api/admin/data/database
    }
    @ordinaryApi {
        path /api/*
        not path /api/admin/data/full /api/admin/data/database
    }
    # File limit plus 1 MiB for multipart framing.
    request_body @fullRestore {
        max_size 2148532224
    }
    request_body @databaseRestore {
        max_size 1074790400
    }
    request_body @ordinaryApi {
        max_size 22MB
    }

    @backend path /api/* /docs /docs/* /openapi.json /redoc

    handle @backend {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
