# UknowApp — пример настроек. Скопируйте в .env один раз: cp .env.example .env
# Не заменяйте существующий .env при обновлении: в нём хранятся рабочие секреты.
# Не добавляйте реальные токены и пароли в Git.

# ДОСТУП АДМИНИСТРАТОРА
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password

# БОТЫ
# Telegram: токен от @BotFather. MAX: токен, выданный создателем MAX-бота.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
# Каналы, в которые Core отправляет сообщения. Пусто — только веб-панель.
BOTS_PLATFORMS=
# Для Telegram и MAX задайте COMPOSE_PROFILES=gateway,bots,max.
# Эта настройка включает ботов при обычном docker compose up.
COMPOSE_PROFILES=
TELEGRAM_API_MODE=cloud
MAX_WEBHOOK_SECRET=
# Создайте отдельные случайные секреты: openssl rand -hex 32
BOTS_NATS_CORE_PASSWORD=
BOTS_NATS_TELEGRAM_PASSWORD=
BOTS_MEDIA_SECRET_TELEGRAM=
BOTS_NATS_MAX_PASSWORD=
BOTS_MEDIA_SECRET_MAX=

# ОСНОВНОЕ
DOMAIN=localhost
SEED_DEMO_DATA=false
DATABASE_URL=
ALLOWED_ORIGINS=

# PostgreSQL нужен только при выборе DATABASE_URL и профиля postgres.
POSTGRES_DB=uknowapp
POSTGRES_USER=uknowapp
POSTGRES_PASSWORD=

# TELEGRAM API: для обычного cloud-режима оставьте настройки ниже без изменений.
# Режим local использует собственный Telegram Bot API и большие файлы.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=http://telegram-bot-api:8081
TELEGRAM_CACHE_HOST_DIR=/srv/uknow-telegram
TELEGRAM_LISTEN_IP=127.0.0.1
# Переключение: python3 infrastructure/telegram-mode.py cloud|local|status

# WEB PUSH
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_MESSAGE_PREVIEW_ENABLED=false

# Необязательные настройки. Обычно менять не нужно.
# Только для удалённого коннектора: укажите приватные адреса Core и NATS.
# BOTS_NATS_URL=nats://10.0.0.1:4222
# BOTS_MEDIA_URL=http://10.0.0.1:8000
# BOTS_GATEWAY_BIND_IP=10.0.0.1
# UKNOWAPP_DOCKER_SUBNET=172.31.255.0/24
# UKNOWAPP_DOCKER_IP_RANGE=172.31.255.128/25
# UKNOWAPP_CADDY_IP=172.31.255.2
# UKNOWAPP_BACKEND_IP=172.31.255.3
# TELEGRAM_API_IMAGE=aiogram/telegram-bot-api:latest
