# ============================================================
# UKNOWAPP — ПРИМЕР НАСТРОЕК
# ============================================================
# Этот файл — образец. Рабочие настройки хранятся в .env.
# Для новой установки: cp .env.example .env
# Если .env уже существует, НЕ копируйте шаблон поверх него:
# так можно потерять пароль, токен бота и другие настройки.
# Изменения .env.example не перезаписывают .env при сборке.
# Никогда не добавляйте реальные пароли и токены в Git.

# ============================================================
# 1. TELEGRAM-БОТ
# ============================================================

# true — бот включён; false — только веб-панель.
TELEGRAM_BOT_ENABLED=true

# Токен существующего бота, полученный у @BotFather.
# Обязательно заполните для работы бота.
TELEGRAM_BOT_TOKEN=

# Режим Telegram Bot API:
# cloud — официальный api.telegram.org, API ID/Hash не нужны;
# local — собственный Telegram Bot API с поддержкой больших файлов.
TELEGRAM_API_MODE=cloud

# Для cloud оставьте пустым: дополнительный контейнер не нужен.
# Для local на том же VPS укажите telegram.
# Для local на отдельном сервере оставьте пустым.
COMPOSE_PROFILES=

# ============================================================
# Режим независимого коннектора (см. docs/bots-gateway.md):
# COMPOSE_FILE=docker-compose.yml:compose.connectors.yml
# COMPOSE_PROFILES=bots (или bots,telegram / bots,postgres)
# BOTS_GATEWAY_TELEGRAM_SECRET= <сгенерировать через openssl rand -hex 32>
# BOTS_GATEWAY_URL=http://backend:8000
# Без override сохраняется прежний embedded-режим для безопасного обновления.
# Удалённый коннектор: override Core без профиля bots, отдельный compose.connector-remote.yml.
#
# 2. ЛОКАЛЬНЫЙ TELEGRAM API (НУЖЕН ТОЛЬКО В РЕЖИМЕ local)
# ============================================================

# Ключи приложения с https://my.telegram.org/apps.
# В режиме cloud оставьте оба поля пустыми.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Адрес локального API. В режиме cloud не используется.
# При размещении на другом сервере укажите его приватный адрес.
TELEGRAM_API_URL=http://telegram-bot-api:8081

# Каталог кеша локального API на VPS (Docker mount).
TELEGRAM_CACHE_HOST_DIR=/srv/uknow-telegram

# Интерфейс публикации порта 8081: только сам VPS.
# Не открывайте этот HTTP-порт в публичный интернет.
TELEGRAM_LISTEN_IP=127.0.0.1

# ============================================================
# 3. ДОСТУП АДМИНИСТРАТОРА
# ============================================================

# Логин для входа в веб-панель.
ADMIN_USERNAME=admin

# ОБЯЗАТЕЛЬНО замените пример на уникальный пароль от 16 символов.
# При обновлении проекта сохраняйте существующий рабочий пароль.
ADMIN_PASSWORD=replace-with-a-long-random-password

# ============================================================
# 4. БАЗА ДАННЫХ
# ============================================================

# Пустое значение означает SQLite в Docker-томе app_data.
# PostgreSQL (пароль в URL должен быть URL-encoded):
# DATABASE_URL=postgresql+psycopg://uknowapp:YOUR_PASSWORD@postgres:5432/uknowapp  # pragma: allowlist secret
# Для встроенного PostgreSQL: COMPOSE_PROFILES=postgres (или postgres,telegram).
DATABASE_URL=

# Только для встроенного PostgreSQL (профиль postgres).
POSTGRES_DB=uknowapp
POSTGRES_USER=uknowapp
POSTGRES_PASSWORD=

# false — не создавать демонстрационных учеников и преподавателей.
SEED_DEMO_DATA=false

# ============================================================
# 5. ВЕБ-ПАНЕЛЬ И ДОМЕН
# ============================================================

# Для VPS замените localhost на реальное доменное имя без https://.
# Например: school.example.com (это пример, не настоящий домен).
DOMAIN=localhost

# Для веб-панели, открываемой через тот же домен Caddy, оставьте пустым.
# Заполняйте только для разрешённых запросов с другого origin.
# Например: http://localhost:22222,http://127.0.0.1:22222
ALLOWED_ORIGINS=

# ============================================================
# 6. PUSH-УВЕДОМЛЕНИЯ
# ============================================================

# Оставьте пустыми для автоматической генерации и хранения VAPID-ключей.
# Если свои ключи уже заданы, при обновлениях НЕ меняйте их.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Контакт для Web Push. На рабочем сервере укажите свой адрес.
VAPID_SUBJECT=mailto:admin@example.com

# По умолчанию push содержит только имя отправителя (администратору — от кого и кому).
# true — снова показывать короткий предпросмотр текста или тип вложения.
# Для действующего сервера добавьте параметр в .env и перезапустите backend.
PUSH_MESSAGE_PREVIEW_ENABLED=false

# ============================================================
# 7. НЕОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ DOCKER (ПРИ НЕОБХОДИМОСТИ)
# ============================================================

# Подсеть Docker. Обычно не требуется менять.
# UKNOWAPP_DOCKER_SUBNET=172.31.255.0/24

# Образ собственного Telegram Bot API. Обычно оставьте как есть.
# TELEGRAM_API_IMAGE=aiogram/telegram-bot-api:latest

# ============================================================
# КАК ПЕРЕКЛЮЧАТЬ TELEGRAM API
# ============================================================
# Сейчас (обычный API): TELEGRAM_API_MODE=cloud, COMPOSE_PROFILES=
# Позже (локальный API): TELEGRAM_API_MODE=local, COMPOSE_PROFILES=telegram
# При переходе cloud -> local сначала остановите polling и выполните
# официальный Telegram Bot API метод logOut на облачном API.
# Инструкция: docs/telegram-service-architecture.md
