# Telegram BotFather token. Leave empty to run admin panel without Telegram.
TELEGRAM_BOT_TOKEN=

# Local admin panel credentials (change before use).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Absolute path is not required; the app stores SQLite under ./data by default.
DATABASE_URL=
# Set true to create a sample teacher/student pair for the hierarchy graph.
SEED_DEMO_DATA=false
