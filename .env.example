# Optional Telegram transport module. Set false to disable it without removing its token.
TELEGRAM_BOT_ENABLED=true
# Telegram BotFather token. Leave empty to run UknowApp without the Telegram adapter.
TELEGRAM_BOT_TOKEN=

# Same host: enable COMPOSE_PROFILES=telegram and set API ID/hash from my.telegram.org.
# Remote host: leave the profile off, set the private URL and mount its cache read-only.
# See docs/telegram-service-architecture.md for setup and cloud cutover.
COMPOSE_PROFILES=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=http://telegram-bot-api:8081
TELEGRAM_CACHE_HOST_DIR=/srv/uknow-telegram
TELEGRAM_LISTEN_IP=127.0.0.1

# Change these before exposing the service on a VPS.
# Use a unique random password with at least 16 characters (24+ recommended).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Local SQLite path. Docker Compose overrides this with a persistent volume path.
DATABASE_URL=

# Browser origins allowed to call the API directly (local development).
# The VPS setup uses the same domain through Caddy, so cross-origin access is not needed.
ALLOWED_ORIGINS=http://localhost:22222,http://127.0.0.1:22222

# For VPS deployment, set this to a real DNS name pointing to the server.
# Caddy provisions and renews HTTPS certificates automatically.
DOMAIN=localhost

# Optional demo data for a fresh database only.
SEED_DEMO_DATA=false

# Web Push keys are generated automatically and stored in the persistent data volume.
# Optional: supply BOTH keys to use your own VAPID pair; never share the private key.
# VAPID_PRIVATE_KEY accepts a PEM file path or a base64url-encoded 32-byte private scalar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Set a real contact address or URL for your service.
VAPID_SUBJECT=mailto:admin@example.com
