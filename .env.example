# Telegram BotFather token. Leave empty to run the admin panel without Telegram.
TELEGRAM_BOT_TOKEN=

# Change these before exposing the service on a VPS.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Local SQLite path. Docker Compose overrides this with a persistent volume path.
DATABASE_URL=

# Browser origins allowed to call the API directly (local development).
# The VPS setup uses the same domain through Caddy, so cross-origin access is not needed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For VPS deployment, set this to a real DNS name pointing to the server.
# Caddy provisions and renews HTTPS certificates automatically.
DOMAIN=localhost

# Optional demo data for a fresh database only.
SEED_DEMO_DATA=false
