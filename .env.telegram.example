# Copy to .env.telegram on the SECONDARY server; never commit populated secrets.
TELEGRAM_BOT_TOKEN=put-real-BotFather-token-here
TELEGRAM_GATEWAY_TOKEN=use-an-independent-random-64-hex-character-value
TELEGRAM_WEBHOOK_SECRET=use-a-different-random-64-hex-character-value
